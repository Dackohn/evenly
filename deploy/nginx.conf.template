# Evenly — generated by deploy/install.sh. Contains the secret URL prefix: keep this file root-only.
limit_req_zone $binary_remote_addr zone=evenly_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=evenly_app:10m rate=30r/s;

server {
    listen 80;
    listen [::]:80;
    server_name __HOST__;
    location /.well-known/acme-challenge/ { root /var/www/acme-evenly; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __HOST__;

    ssl_certificate     /etc/letsencrypt/live/__HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    server_tokens off;
    client_max_body_size 9m;
    access_log /var/log/nginx/evenly.access.log;
    error_log  /var/log/nginx/evenly.error.log warn;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Only the secret prefix leads anywhere. Every other URL on this host is a bare 404,
    # so the app cannot be discovered by scanning.
    location = /__SECRET__ { return 301 /__SECRET__/; }

    location /__SECRET__/api/auth/ {
        limit_req zone=evenly_auth burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://unix:/run/evenly/app.sock:/api/auth/;
        include /etc/nginx/snippets/evenly-proxy.conf;
    }
    location /__SECRET__/ {
        limit_req zone=evenly_app burst=80 nodelay;
        limit_req_status 429;
        proxy_pass http://unix:/run/evenly/app.sock:/;
        include /etc/nginx/snippets/evenly-proxy.conf;
    }
    location / { return 404; }
}
